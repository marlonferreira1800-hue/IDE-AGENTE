{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swarm IDE",
  "version": "0.1.0",
  "identifier": "dev.swarm.ide",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Swarm IDE — Rust + Tauri",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
